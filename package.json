{
  "name": "zerosoft",
  "version": "0.0.1",
  "private": true,
  "description": "El software murió. Todo el software que usás, gratis. Open source o nube al costo.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "seed": "tsx scripts/seed.ts && tsx scripts/seed-crm.ts",
    "lint": "eslint . --ext .ts,.tsx --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:real": "playwright test -c playwright.real.config.ts",
    "gen:fragments": "node scripts/gen-fragments.mjs",
    "pretypecheck": "npm run gen:fragments",
    "prelint": "npm run gen:fragments",
    "postinstall": "node -e \"require('fs').existsSync('scripts/gen-fragments.mjs') && import('./scripts/gen-fragments.mjs').then(m => m.genFragments())\""
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "3.0.68",
    "@excalidraw/excalidraw": "^0.18.1",
    "@libsql/client": "^0.17.4",
    "@napi-rs/canvas": "^1.1.0",
    "@vercel/blob": "^2.8.1",
    "@vercel/sandbox": "^3.7.0",
    "@xyflow/react": "^12.12.0",
    "ai": "^7.0.138",
    "geoip-lite": "^2.0.3",
    "gray-matter": "^4.0.3",
    "katex": "^0.18.11",
    "marked": "^14.1.4",
    "mysql2": "^3.24.6",
    "nanoid": "^5.0.9",
    "next": "^15.5.27",
    "next-auth": "^4.24.15",
    "next-intl": "^4.14.9",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.4.299",
    "pg": "^8.23.1",
    "playwright-core": "^1.64.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sanitize-html": "^2.18.0",
    "ua-parser-js": "^1.0.40",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "@electric-sql/pglite-socket": "^0.2.18",
    "@playwright/test": "^1.64.0",
    "@types/geoip-lite": "^1.4.4",
    "@types/node": "^22.20.5",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sanitize-html": "^2.16.2",
    "@types/ua-parser-js": "^0.7.39",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.5.27",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^5.0.4"
  },
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "postcss": "^8.5.29",
    "lodash-es": "^4.18.1",
    "katex": "$katex",
    "@excalidraw/excalidraw": {
      "nanoid": "^3.3.18"
    },
    "@excalidraw/mermaid-to-excalidraw": {
      "nanoid": "^5.1.16"
    },
    "@vercel/cli-config": {
      "zod": "^4.6.7"
    },
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.1"
    }
  },
  "license": "AGPL-3.0-only"
}
