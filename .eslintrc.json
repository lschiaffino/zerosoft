{
  "extends": [
    "next/core-web-vitals"
  ],
  "plugins": [
    "@typescript-eslint"
  ],
  "ignorePatterns": [
    "public/",
    "scripts/_*",
    "/desktop/"
  ],
  "overrides": [
    {
      "files": [
        "components/shop/**/*.tsx"
      ],
      "rules": {
        "@next/next/no-img-element": "off"
      }
    }
  ]
}
