# Offline development: every app works without accounts, API keys or network.
#
#   cp .env.offline.example .env.local
#   npm run seed
#   npm run dev            # http://localhost:3000/en/app
#
# Nothing here is a secret. Never use these values in production: the *_FAKE
# flags replace real providers with local stand-ins, and most of them refuse
# to run on a Vercel production deploy anyway.
# For the full list of real settings, see .env.example and docs/self-hosting.md.

# --- Core ---
# Everyone is the shared demo user (demo@zerosoft.ai), no sign-in needed.
DEMO_MODE=true
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=offline-dev-only-not-a-secret
SHORT_DOMAIN=localhost:3000
# The demo user can open the admin pages (feedback, roadmap, changelog).
ADMIN_EMAILS=demo@zerosoft.ai
# Lets you call the crons by hand:
#   curl -H "Authorization: Bearer dev-cron" http://localhost:3000/api/cron/minute
CRON_SECRET=dev-cron
# status.zerosoft.ai: the minute cron's checks skip the network (only the local database is checked).
STATUS_CHECKS_FAKE=1
# Database: unset = local SQLite file at data/zerosoftware.db.
TURSO_DATABASE_URL=
# Email: unset = emails are printed to the console.
RESEND_API_KEY=
# Uncomment to also write each email as a JSON line (handy to grab sign-in codes and links).
# EMAIL_CAPTURE_FILE=data/mail.jsonl
# Files: without a Blob token, uploads (and private attachments of any type,
# encrypted) go to UPLOADS_DIR (default data/uploads). Attachments cap:
# FILES_LOCAL_MAX_BYTES (default 2 GiB).
# FILES_LOCAL_MAX_BYTES=

# --- AI ---
# No real model. Each app below uses its own fake model, so AI features
# answer with fixed, predictable text. In most apps the cookie <app>_ai_fake=off
# (for example crm_ai_fake=off) shows the "AI disabled" state instead.
AI_GATEWAY_API_KEY=
OPENROUTER_API_KEY=
AI_FREE_TOKENS_PER_MONTH=unlimited
ASSISTANT_FAKE=1
BOARD_AI_FAKE=1
CHAT_AI_FAKE=1
CRM_AI_FAKE=1
DOCS_AI_FAKE=1
GROUPS_AI_FAKE=1
HIRING_AI_FAKE=1
LINK_AI_FAKE=1
REC_AI_FAKE=1
ROBOTS_AI_FAKE=1
TALK_AI_FAKE=1
TRACK_AI_FAKE=1
VOICE_AI_FAKE=1
VOICE_TRANSCRIBE_PROVIDER=fake
# Calls: the analysis runs without a model, and "send the bot" simulates a short
# recorded meeting instead of calling services/calls-bot.
CALLS_AI_FAKE=1
CALLS_BOT_FAKE=1
# Agents and Flow use the fake model only on requests that carry the cookie
# agents_ai_fake=on or flow_ai_fake=on; without it they behave as if AI is off.
AGENTS_AI_FAKE=1
FLOW_AI_FAKE=1

# --- CRM ---
# Import from HubSpot and others with the token "fake".
CRM_IMPORT_FAKE=1
# Company details from a domain, without calling out.
CRM_ENRICH_FAKE=1
# Slack, Zoom and Stripe apps in test mode.
CRM_APPS_FAKE=1
# In-browser calling with a simulated device.
CRM_VOICE_FAKE=1
# Outlook / Microsoft 365 against a fake Graph API.
MS_GRAPH_FAKE=1
# Form CAPTCHA always passes.
CAPTCHA_FAKE=1

# --- Cal ---
CAL_GOOGLE_FAKE=1
CAL_ICLOUD_FAKE=1
CAL_SMS_FAKE=1

# --- Chat ---
# Inbound email channel without Resend signatures.
CHAT_INBOUND_FAKE=1
CHAT_INBOUND_DOMAIN=inbound.zerosoft.test

# --- Lines (WhatsApp) ---
# A fake WhatsApp provider: nothing is sent to WhatsApp.
GROUPS_FAKE=1
# Slack, Freshdesk, Zoho Desk and HubSpot answered by an in-memory fake.
GROUPS_INTEGRATIONS_FAKE=1
GROUPS_PUSH_FAKE=1
# GIFs tab in Lines and Inbox: sample GIFs instead of GIPHY or Tenor (the cookie wa_gifs_fake=off shows the "not set up" state).
GROUPS_GIFS_FAKE=1

# --- Docs and Notes ---
# Notion import with the token "fake-notion".
NOTION_IMPORT_FAKE=1
# Track: import de Linear por API contra un workspace falso (key lin_api_fake; lin_api_fake_big trae 2.500 issues).
TRACK_LINEAR_FAKE=1
# Bookmark previews and synced databases (GitHub, Jira, Salesforce) with fixed data.
DOCS_UNFURL_FAKE=1
DOCS_SYNC_FAKE=1
# Custom domains ending in .test verify without DNS.
DOCS_DOMAIN_FAKE=1
DOCS_SITE_LOOKUP_ORIGIN=http://localhost:3000

# --- Track ---
SLACK_FAKE=1
GITHUB_APP_FAKE=1
TRACK_SUPPORT_FAKE=1

# --- Link ---
# Safe Browsing flags only Google's test URLs; Rebrandly/Short.io import and
# Segment run against fakes.
LINK_SAFETY_FAKE=1
LINK_IMPORT_FAKE=1
LINK_INTEGRATIONS_FAKE=1

# --- Agents ---
# Stripe, Shopify, Slack, Meta and Zendesk without calling out.
AGENTS_INTEGRATIONS_FAKE=1

# --- Robots ---
# Google Sheets / Airtable destinations without calling out. Running a robot
# still needs a local Chromium: npx playwright-core install chromium
ROBOTS_DESTINATIONS_FAKE=1

# --- Social ---
# Fake networks: connect, publish, comments and metrics without calling out.
SOCIAL_FAKE=1

# --- Voice ---
VOICE_NOTION_FAKE=1

# --- Talk ---
# Huddles use local candidates only (no public STUN server).
TALK_STUN_URLS=none

# --- Shop and Books ---
# Stripe and Mercado Pago without calling out; a signed local webhook marks the payment.
SHOP_PAYMENTS_FAKE=1
BOOKS_PAYMENTS_FAKE=1

# --- Desktop download page ---
# A fixed desktop release instead of asking GitHub.
DESKTOP_RELEASES_FAKE=1
