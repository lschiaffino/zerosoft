<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleLocalizations</key>
	<array>
		<string>en</string>
		<string>es</string>
		<string>pt</string>
	</array>
	<key>CFBundleDisplayName</key>
	<string>zerosoft</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>zerosoft</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<!-- zerosoft:// links (DeepLink.swift): only zerosoft://open with an app path does anything.
	     ZS_URL_SCHEME (project.yml) is zerosoft in Debug (UI tests) and zerosoft-mac in Release:
	     the Tauri app also registers zerosoft and finishes its Google sign-in through it, so the
	     Swift app takes the scheme only when it replaces the Tauri Mac build (decision 7.5).
	     Its own sign-in does not need the scheme registered (ASWebAuthenticationSession). -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>ai.zerosoft.mac</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>$(ZS_URL_SCHEME)</string>
			</array>
		</dict>
	</array>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.productivity</string>
	<key>LSMinimumSystemVersion</key>
	<string>$(MACOSX_DEPLOYMENT_TARGET)</string>
	<key>NSAppTransportSecurity</key>
	<dict>
		<!-- http only for localhost (development and self-hosting tests); Server.normalize
		     refuses plain http for any other host. -->
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!-- Dictation (block 6): asked the first time the person dictates or presses "Turn on the
	     microphone", never at launch. -->
	<key>NSMicrophoneUsageDescription</key>
	<string>zerosoft records your voice while you dictate: from the shortcut until you let go, tap again or reach 2 minutes. The audio goes to your zerosoft server to become text.</string>
	<!-- Meetings (block 7): the computer's audio, captured only while a meeting the person started
	     records. macOS 14.2 and later ask for system audio recording (Core Audio taps) the first
	     time; macOS 13 to 14.1 need Screen Recording (ScreenCaptureKit), asked for on the first
	     capture or from Settings › Permissions. Never at launch. -->
	<key>NSAudioCaptureUsageDescription</key>
	<string>zerosoft captures the computer's audio only while a meeting you started records, so its notes include the other people on the call. The audio goes to your zerosoft server.</string>
	<key>NSScreenCaptureUsageDescription</key>
	<string>Rec records your screen from its page, only after you start a recording and pick what to share. On macOS 14.1 and earlier, zerosoft also needs Screen Recording to capture the computer's audio while a meeting you started records.</string>
	<!-- Rec (block 8): the camera for the page (Talk, Rec) and for Rec's camera bubble, which
	     only previews it on screen. Asked on first use or from Settings › Permissions. -->
	<key>NSCameraUsageDescription</key>
	<string>zerosoft uses the camera for video calls and for Rec recordings with your camera, only after you start one. During a Rec recording your camera shows in a round bubble on top of other apps.</string>
	<!-- Auto-paste of dictated text (decision 7.1, section 5.1): YES posts Command+V once the
	     person allows it in Privacy & Security › Accessibility; NO only copies. From the
	     ZS_AUTO_PASTE build setting (project.yml). -->
	<key>ZSAutoPaste</key>
	<string>$(ZS_AUTO_PASTE)</string>
	<key>NSPrincipalClass</key>
	<string>NSApplication</string>
	<key>NSSupportsAutomaticTermination</key>
	<false/>
	<key>NSSupportsSuddenTermination</key>
	<false/>
</dict>
</plist>
