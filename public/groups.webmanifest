{
  "id": "/app/groups",
  "name": "Groups by zerosoft",
  "short_name": "Groups",
  "description": "WhatsApp inbox for teams: chats, groups, tickets and broadcasts.",
  "start_url": "/app/groups/inbox?source=pwa",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "orientation": "any",
  "background_color": "#0d0d0d",
  "theme_color": "#0d0d0d",
  "categories": ["business", "productivity", "social"],
  "icons": [
    { "src": "/api/groups/pwa-icon?size=192", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/api/groups/pwa-icon?size=512", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/api/groups/pwa-icon?size=512&maskable=1", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Inbox", "url": "/app/groups/inbox", "icons": [{ "src": "/api/groups/pwa-icon?size=192", "sizes": "192x192" }] },
    { "name": "Tickets", "url": "/app/groups/tickets", "icons": [{ "src": "/api/groups/pwa-icon?size=192", "sizes": "192x192" }] }
  ]
}
