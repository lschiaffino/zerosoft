{
  "name": "zerosoft-desktop",
  "productName": "zerosoft",
  "private": true,
  "version": "0.3.0",
  "description": "zerosoft for Mac and Windows (Tauri): the whole platform in a native window and dictation in any app.",
  "author": "zerosoft <hello@zerosoft.ai>",
  "homepage": "https://zerosoft.ai/download",
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "build:ui": "node scripts/build-ui.mjs",
    "typecheck": "tsc --noEmit -p .",
    "dev": "tauri dev",
    "build": "tauri build",
    "test": "cargo test --manifest-path src-tauri/Cargo.toml --lib",
    "icons": "tauri icon build/icon.png -o src-tauri/icons"
  },
  "devDependencies": {
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/cli": "^2.9.0",
    "esbuild": "~0.27.0",
    "typescript": "~5.7.2"
  },
  "allowScripts": {
    "esbuild": true,
    "@tauri-apps/cli": true
  }
}
