{
  "name": "zerosoft-desktop",
  "productName": "zerosoft",
  "private": true,
  "version": "0.1.0",
  "description": "zerosoft for Mac and Windows: the whole platform, dictation in any app and meeting notes with system audio.",
  "author": "zerosoft <hello@zerosoft.ai>",
  "homepage": "https://zerosoft.ai/download",
  "license": "AGPL-3.0-only",
  "main": "dist/main.js",
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "npm run build && electron .",
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p tsconfig.renderer.json",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "dist:mac": "npm run build && electron-builder --mac --arm64 --x64",
    "dist:win": "npm run build && electron-builder --win --x64 --arm64"
  },
  "dependencies": {
    "electron-updater": "~6.8.3",
    "uiohook-napi": "~1.5.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "electron": "~44.9.0",
    "electron-builder": "~26.17.0",
    "esbuild": "~0.27.0",
    "typescript": "~5.7.2"
  },
  "allowScripts": {
    "electron": true,
    "esbuild": true
  }
}
