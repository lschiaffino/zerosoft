{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "remote",
  "description": "La página de zerosoft en la ventana principal: solo el puente (versión, login, Ajustes, avisos y el estado de la grabación). Un servidor propio se suma en runtime (lib.rs, allow_server).",
  "windows": [
    "main"
  ],
  "remote": {
    "urls": [
      "https://zerosoft.ai/*",
      "http://localhost:*/*"
    ]
  },
  "permissions": [
    "allow-desktop-info",
    "allow-desktop-start-login",
    "allow-desktop-open-settings",
    "allow-desktop-notify",
    "allow-desktop-recording",
    "allow-desktop-system-audio-start",
    "allow-desktop-system-audio-read",
    "allow-desktop-system-audio-stop"
  ]
}
