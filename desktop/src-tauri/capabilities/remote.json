{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "remote",
  "description": "La página de zerosoft en cada pestaña (webviews \"tab-<id>\", tabs.rs): solo el puente (versión, login, Ajustes, avisos, el estado de la grabación, la barra de Rec y las pestañas). Un servidor propio se suma en runtime (lib.rs, allow_server).",
  "webviews": [
    "tab-*"
  ],
  "remote": {
    "urls": [
      "https://zerosoft.ai/*",
      "http://localhost:*/*"
    ]
  },
  "permissions": [
    "allow-desktop-info",
    "allow-desktop-start-login",
    "allow-desktop-open-settings",
    "allow-desktop-notify",
    "allow-desktop-recording",
    "allow-desktop-tabs",
    "allow-desktop-system-audio-start",
    "allow-desktop-system-audio-read",
    "allow-desktop-system-audio-stop",
    "allow-desktop-rec-overlay",
    "allow-desktop-rec-level"
  ]
}
