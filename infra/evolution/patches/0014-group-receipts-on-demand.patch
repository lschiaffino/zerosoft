+    if (!(await zsEnsureReceiptTable(this.prismaRepository))) throw new NotFoundException('Message receipts are not available');
+    // Lo que todavía está en la cola sale antes de leer.
+    zsReceiptPrisma = this.prismaRepository;
+    await zsFlushReceipts();
+    const id = String(data.id).slice(0, 100);
+    const rows: any[] = data.remoteJid
+      ? await this.prismaRepository.$queryRawUnsafe(
+          'SELECT "userJid", "deliveredAt", "readAt", "playedAt" FROM "ZsMessageReceipt" WHERE "instanceId" = $1 AND "keyId" = $2 AND "remoteJid" = $3 LIMIT 2000',
+          this.instanceId,
+          id,
+          String(data.remoteJid).slice(0, 100),
+        )
+      : await this.prismaRepository.$queryRawUnsafe(
+          'SELECT "userJid", "deliveredAt", "readAt", "playedAt" FROM "ZsMessageReceipt" WHERE "instanceId" = $1 AND "keyId" = $2 LIMIT 2000',
+          this.instanceId,
+          id,
+        );
+    const receipts = [];
+    for (const r of rows) {
+      let phone: string | undefined;
+      if (typeof r.userJid === 'string' && r.userJid.endsWith('@lid')) {
+        try {
+          const pn = await this.client?.signalRepository?.lidMapping?.getPNForLID(r.userJid);
+          if (pn) phone = jidNormalizedUser(pn);
+        } catch {
+          // Sin teléfono conocido: va solo el lid.
+        }
+      }
+      receipts.push({
+        userJid: r.userJid,
+        ...(phone ? { phone } : {}),
+        deliveredAt: r.deliveredAt ?? null,
+        readAt: r.readAt ?? null,
+        playedAt: r.playedAt ?? null,
+      });
+    }
+    return { id, receipts };
+  }
