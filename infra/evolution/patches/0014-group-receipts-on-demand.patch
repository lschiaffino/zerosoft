+# zerosoft (0014): en un grupo, Baileys 7.0.0-rc.9 guarda la confirmación de "escuchado" (un audio) como
+# readTimestamp, igual que "leído". Acá va como playedTimestamp, para la Info del mensaje ("Escuchado por").
+# Falla el build si la línea cambió.
+RUN f=node_modules/baileys/lib/Socket/messages-recv.js && \
+    grep -q "const updateKey = status === proto.WebMessageInfo.Status.DELIVERY_ACK ? 'receiptTimestamp' : 'readTimestamp';" "$f" && \
+    sed -i "s/const updateKey = status === proto.WebMessageInfo.Status.DELIVERY_ACK ? 'receiptTimestamp' : 'readTimestamp';/const updateKey = status === proto.WebMessageInfo.Status.DELIVERY_ACK ? 'receiptTimestamp' : status === proto.WebMessageInfo.Status.PLAYED ? 'playedTimestamp' : 'readTimestamp';/" "$f" && \
+    grep -q "Status.PLAYED ? 'playedTimestamp'" "$f"
+
 COPY ./src ./src
 COPY ./public ./public
 COPY ./prisma ./prisma
