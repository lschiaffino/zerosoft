+// zerosoft (0014): "Leído por" / "Entregado a" de los mensajes propios en grupos, sin webhooks.
+// Baileys emite message-receipt.update por persona (en un grupo de 200 son 400 eventos por mensaje). En vez de
+// mandarlos al webhook (0011 saturó la base de zerosoft), se juntan en memoria, se escriben de a tandas en una
+// tabla propia (ZsMessageReceipt, clave instancia + mensaje + persona) y zerosoft los pide cuando alguien abre la
+// Info del mensaje (POST /chat/messageReceipts). Apagado salvo ZS_MESSAGE_RECEIPTS=true, y solo con Postgres.
+type ZsReceipt = { instanceId: string; keyId: string; remoteJid: string; userJid: string; delivered: number | null; read: number | null; played: number | null };
+const ZS_RECEIPT_FLUSH_MS = 2_000;
+const ZS_RECEIPT_MAX_QUEUE = 20_000;
+const ZS_RECEIPT_BATCH = 500;
+const ZS_RECEIPT_KEEP_DAYS = 30;
+const zsReceiptQueue = new Map<string, ZsReceipt>();
+let zsReceiptTimer: NodeJS.Timeout | null = null;
+let zsReceiptTable: Promise<boolean> | null = null;
+let zsReceiptPrisma: PrismaRepository | null = null;
+let zsReceiptCleanedAt = 0;
+const zsReceiptStats = { queued: 0, dropped: 0, written: 0, failed: 0 };
+
+function zsReceiptsEnabled(): boolean {
+  if (process.env.ZS_MESSAGE_RECEIPTS !== 'true') return false;
+  const provider = process.env.DATABASE_PROVIDER || 'postgresql';
+  return provider === 'postgresql' || provider === 'psql_bouncer';
+}
+
+const zsMin = (a: number | null, b: number | null) => (a === null ? b : b === null ? a : Math.min(a, b));
+const zsSeconds = (v: unknown): number | null => {
+  const n = Number(v);
+  return Number.isFinite(n) && n > 0 ? Math.floor(n > 1e12 ? n / 1000 : n) : null;
+};
+
+function zsEnsureReceiptTable(prisma: PrismaRepository): Promise<boolean> {
+  if (!zsReceiptTable) {
+    zsReceiptTable = (async () => {
+      await prisma.$executeRawUnsafe(`CREATE TABLE IF NOT EXISTS "ZsMessageReceipt" (
+        "instanceId" VARCHAR(100) NOT NULL,
+        "keyId" VARCHAR(100) NOT NULL,
+        "remoteJid" VARCHAR(100) NOT NULL,
+        "userJid" VARCHAR(100) NOT NULL,
+        "deliveredAt" INTEGER,
+        "readAt" INTEGER,
+        "playedAt" INTEGER,
+        "updatedAt" TIMESTAMP NOT NULL DEFAULT now(),
+        PRIMARY KEY ("instanceId", "keyId", "userJid"))`);
+      await prisma.$executeRawUnsafe('CREATE INDEX IF NOT EXISTS "ZsMessageReceipt_updatedAt_idx" ON "ZsMessageReceipt" ("updatedAt")');
+      return true;
+    })().catch((err) => {
+      zsReceiptTable = null;
+      console.error('[zs-receipts] could not create the table', (err as any)?.message ?? err);
+      return false;
+    });
+  }
+  return zsReceiptTable;
+}
+
+/** Junta las confirmaciones en memoria (la misma persona y mensaje queda en una fila, con la primera hora). */
+function zsQueueReceipts(instanceId: string, prisma: PrismaRepository, list: MessageUserReceiptUpdate[], own: string[]) {
+  zsReceiptPrisma = prisma;
+  for (const ev of list) {
+    const key = ev?.key;
+    const r: any = ev?.receipt ?? {};
+    const remoteJid = typeof key?.remoteJid === 'string' ? key.remoteJid : '';
+    const userJid = typeof r.userJid === 'string' ? jidNormalizedUser(r.userJid) : '';
+    // Solo grupos, solo mensajes propios, nunca la propia cuenta (otros dispositivos).
+    if (!key?.id || !remoteJid.endsWith('@g.us') || key.fromMe === false || !userJid || own.includes(userJid)) continue;
+    const row: ZsReceipt = {
+      instanceId,
+      keyId: String(key.id).slice(0, 100),
+      remoteJid: remoteJid.slice(0, 100),
+      userJid: userJid.slice(0, 100),
+      delivered: zsSeconds(r.receiptTimestamp),
+      read: zsSeconds(r.readTimestamp),
+      played: zsSeconds(r.playedTimestamp),
+    };
+    if (row.delivered === null && row.read === null && row.played === null) continue;
+    const id = `${instanceId}|${row.keyId}|${row.userJid}`;
+    const prev = zsReceiptQueue.get(id);
+    if (prev) {
+      prev.delivered = zsMin(prev.delivered, row.delivered);
+      prev.read = zsMin(prev.read, row.read);
+      prev.played = zsMin(prev.played, row.played);
+      continue;
+    }
+    // Tope: con la base caída la cola no crece sin límite (se pierde lo que no entra; zerosoft muestra lo que hay).
+    if (zsReceiptQueue.size >= ZS_RECEIPT_MAX_QUEUE) {
+      zsReceiptStats.dropped++;
+      continue;
+    }
+    zsReceiptQueue.set(id, row);
+    zsReceiptStats.queued++;
+  }
+  if (zsReceiptQueue.size && !zsReceiptTimer) {
+    zsReceiptTimer = setTimeout(() => {
+      zsReceiptTimer = null;
+      void zsFlushReceipts();
+    }, ZS_RECEIPT_FLUSH_MS);
+  }
+}
+
+/** Escribe la cola: un INSERT de hasta 500 filas por sentencia; cada hora queda con la más temprana. */
+async function zsFlushReceipts(): Promise<void> {
+  const prisma = zsReceiptPrisma;
+  if (!prisma || !zsReceiptQueue.size) return;
+  if (!(await zsEnsureReceiptTable(prisma))) return;
+  const rows = [...zsReceiptQueue.values()];
+  zsReceiptQueue.clear();
+  for (let i = 0; i < rows.length; i += ZS_RECEIPT_BATCH) {
+    const chunk = rows.slice(i, i + ZS_RECEIPT_BATCH);
+    const values: unknown[] = [];
+    const marks = chunk.map((r, j) => {
+      values.push(r.instanceId, r.keyId, r.remoteJid, r.userJid, r.delivered, r.read, r.played);
+      const b = j * 7;
+      return `($${b + 1}, $${b + 2}, $${b + 3}, $${b + 4}, $${b + 5}::int, $${b + 6}::int, $${b + 7}::int, now())`;
+    });
+    try {
+      await prisma.$executeRawUnsafe(
+        `INSERT INTO "ZsMessageReceipt" ("instanceId", "keyId", "remoteJid", "userJid", "deliveredAt", "readAt", "playedAt", "updatedAt")
+         VALUES ${marks.join(', ')}
+         ON CONFLICT ("instanceId", "keyId", "userJid") DO UPDATE SET
+           "deliveredAt" = LEAST("ZsMessageReceipt"."deliveredAt", EXCLUDED."deliveredAt"),
+           "readAt" = LEAST("ZsMessageReceipt"."readAt", EXCLUDED."readAt"),
+           "playedAt" = LEAST("ZsMessageReceipt"."playedAt", EXCLUDED."playedAt"),
+           "updatedAt" = now()`,
+        ...values,
+      );
+      zsReceiptStats.written += chunk.length;
+    } catch (err) {
+      zsReceiptStats.failed += chunk.length;
+      console.error('[zs-receipts] write failed', (err as any)?.message ?? err);
+    }
+  }
+  // Lo de más de 30 días se borra (una vez por hora y por proceso).
+  if (Date.now() - zsReceiptCleanedAt > 3_600_000) {
+    zsReceiptCleanedAt = Date.now();
+    await prisma
+      .$executeRawUnsafe(`DELETE FROM "ZsMessageReceipt" WHERE "updatedAt" < now() - interval '${ZS_RECEIPT_KEEP_DAYS} days'`)
+      .catch(() => undefined);
+  }
+  (globalThis as any).__zsReceipts = { ...zsReceiptStats, pending: zsReceiptQueue.size };
+}
