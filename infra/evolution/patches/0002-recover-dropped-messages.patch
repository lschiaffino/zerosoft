+  // zerosoft: a message WhatsApp delivered that could not be decrypted (or came without content) used to be dropped
+  // silently. Now the phone is asked once to resend it, and the webhook gets a MESSAGES_UPSERT without `message` and
+  // with `zsUndecryptable: true`, so whoever listens knows a message is missing and can ask for the chat's history.
+  private readonly zsResendRequested = new Set<string>();
+
+  private zsUndecryptable(received: WAMessage) {
+    const key = received?.key;
+    if (!key?.id || !key.remoteJid || key.remoteJid === 'status@broadcast') return;
+    if (this.zsResendRequested.has(key.id)) return;
+    if (this.zsResendRequested.size > 5000) this.zsResendRequested.clear();
+    this.zsResendRequested.add(key.id);
+
+    const reason = String(received.messageStubParameters?.[0] ?? '');
+    this.logger.warn(`zerosoft: undecryptable message ${key.id} in ${key.remoteJid} (${reason}), asking the phone`);
+    // Not awaited: Baileys waits a few seconds before sending the request, and the event queue must not stop.
+    this.client
+      .requestPlaceholderResend(key)
+      .then((requestId) => this.logger.info(`zerosoft: resend requested for ${key.id} (${requestId ?? 'already'})`))
+      .catch((error) => this.logger.warn(`zerosoft: resend request failed for ${key.id}: ${error?.toString()}`));
+
+    const timestamp = Long.isLong(received.messageTimestamp)
+      ? received.messageTimestamp.toNumber()
+      : Number(received.messageTimestamp) || undefined;
+    this.sendDataWebhook(Events.MESSAGES_UPSERT, {
+      key,
+      pushName: received.pushName,
+      messageTimestamp: timestamp,
+      messageStubType: 'CIPHERTEXT',
+      messageStubParameters: received.messageStubParameters,
+      zsUndecryptable: true,
+      instanceId: this.instanceId,
+    });
+  }
+
