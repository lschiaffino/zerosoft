+    const sameChat = {
+      OR: [{ key: { path: ['remoteJid'], equals: jid } }, { key: { path: ['remoteJidAlt'], equals: jid } }],
+    };
+    const after = Number(data.after) > 0 ? Math.floor(Number(data.after)) : 0;
+    const anchor =
+      (after
+        ? await this.prismaRepository.message.findFirst({
+            where: { instanceId: this.instanceId, messageTimestamp: { gt: after }, ...sameChat },
