+  /** El forwardingScore pedido (1 si no dice), o 0 si no es un reenvío. */
+  private zsForwardScore(forward: any): number {
+    if (!forward || typeof forward !== 'object') return 0;
+    const n = Math.floor(Number(forward.score ?? 1));
+    return Number.isFinite(n) && n >= 1 ? Math.min(n, 1000) : 1;
+  }
+
+  /** Lo que la base guarda como JSON vuelve a bytes: `{ "0": .., "1": .. }` (Uint8Array) y `{ type: 'Buffer', data }`. */
+  private zsRevive(value: any): any {
+    if (value === null || typeof value !== 'object') return value;
+    if (Buffer.isBuffer(value) || value instanceof Uint8Array) return value;
+    if (Array.isArray(value)) return value.map((v) => this.zsRevive(v));
+    if (value.type === 'Buffer' && Array.isArray(value.data)) return Buffer.from(value.data);
+    const keys = Object.keys(value);
+    if (keys.length && keys.every((k) => /^\d+$/.test(k))) {
+      return Uint8Array.from(keys.sort((a, b) => Number(a) - Number(b)).map((k) => Number(value[k])));
+    }
+    const out: any = {};
+    for (const k of keys) out[k] = this.zsRevive(value[k]);
+    return out;
+  }
+
+  /**
+   * El original de un reenvío, si está guardado en esta instancia y es lo mismo que se pide mandar (mismo tipo, mismo
+   * texto o pie, nota de voz o no). Un archivo solo si tiene su clave y su ruta en WhatsApp y es de los últimos 7 días
+   * (después WhatsApp puede haberlo borrado de su servidor y quien lo recibe no podría bajarlo). Si no, null: sale
+   * como un mensaje nuevo con la marca de reenviado.
+   */
+  private async zsForwardOriginal(
+    forward: any,
+    want: { types: string[]; text?: string; caption?: string; ptt?: boolean },
+  ): Promise<{ original: WAMessage; score: number } | null> {
+    const id = forward?.key?.id;
+    if (typeof id !== 'string' || !id || id.length > 128) return null;
+    try {
+      const rows = (await this.prismaRepository.$queryRaw`
+        SELECT "key", "message", "messageTimestamp" FROM "Message"
+        WHERE "instanceId" = ${this.instanceId} AND "key"->>'id' = ${id}
+        LIMIT 1
+      `) as any[];
+      const row = rows?.[0];
+      if (!row?.message || !row?.key) return null;
+      const raw = this.zsRevive(row.message);
+      if (raw.viewOnceMessage || raw.viewOnceMessageV2 || raw.viewOnceMessageV2Extension) return null;
+      const content: any = normalizeMessageContent(proto.Message.fromObject(raw));
+      const type = getContentType(content);
+      if (!type || !want.types.includes(type)) return null;
+      const inner: any = content[type];
+      if (inner?.viewOnce) return null;
+      if (type === 'conversation' || type === 'extendedTextMessage') {
+        const text = type === 'conversation' ? content.conversation : inner?.text;
+        if (String(text ?? '').trim() !== String(want.text ?? '').trim()) return null;
+      } else {
+        if (!(inner?.mediaKey instanceof Uint8Array) || inner.mediaKey.length !== 32 || !inner.directPath) return null;
+        if (want.ptt !== undefined && Boolean(inner.ptt) !== want.ptt) return null;
+        if (want.caption !== undefined && String(inner.caption ?? '').trim() !== want.caption.trim()) return null;
+        const ts = Number(row.messageTimestamp);
+        if (!ts || Date.now() / 1000 - ts > 7 * 24 * 3600) return null;
+      }
+      const message = proto.Message.fromObject({ [type]: inner });
+      const original = { key: row.key, message } as WAMessage;
+      // Lo que Baileys arma al reenviar: si falla acá, sale como un mensaje nuevo.
+      generateForwardMessageContent(original, true);
+      const before = Number(inner?.contextInfo?.forwardingScore) || 0;
+      return { original, score: Math.min(Math.max(this.zsForwardScore(forward), before + 1), 1000) };
+    } catch (error) {
+      this.logger.warn(`zerosoft forward: original not usable (${error?.message ?? error})`);
+      return null;
+    }
+  }
