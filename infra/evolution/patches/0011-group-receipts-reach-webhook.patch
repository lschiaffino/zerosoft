+  // zerosoft: en un grupo, "entregado" y "leído" de un mensaje propio llegan como message-receipt.update (un aviso
+  // por persona), y Evolution solo los usaba para su base: el webhook nunca los veía y el mensaje quedaba con un
+  // tilde para siempre. Ahora salen como MESSAGES_UPDATE, igual que en un chat 1:1: DELIVERY_ACK con el primer
+  // aviso, y READ cuando leyeron todos los demás participantes (como WhatsApp). La cuenta de lectores vive en
+  // memoria (se pierde al reiniciar) y la de participantes sale de la caché de metadata.
+  private zsGroupReceipts = new Map<string, { delivered: boolean; read: boolean; readers: Set<string> }>();
+
+  private async zsForwardGroupReceipts(payload: MessageUserReceiptUpdate[]) {
+    for (const event of payload ?? []) {
+      const key = event?.key;
+      if (!key?.fromMe || !key.id || !key.remoteJid || !isJidGroup(key.remoteJid)) continue;
+      let seen = this.zsGroupReceipts.get(key.id);
+      if (!seen) {
+        if (this.zsGroupReceipts.size >= 5000) this.zsGroupReceipts.delete(this.zsGroupReceipts.keys().next().value as string);
+        seen = { delivered: false, read: false, readers: new Set<string>() };
+        this.zsGroupReceipts.set(key.id, seen);
+      }
+      const send = (status: string) =>
+        this.sendDataWebhook(Events.MESSAGES_UPDATE, {
+          keyId: key.id,
+          remoteJid: key.remoteJid,
+          fromMe: true,
+          status,
+          instanceId: this.instanceId,
+        });
+      if (!seen.delivered) {
+        seen.delivered = true;
+        send('DELIVERY_ACK');
+      }
+      const receipt: any = event.receipt;
+      if (seen.read || !receipt?.userJid || !(receipt.readTimestamp || receipt.playedTimestamp)) continue;
+      seen.readers.add(jidNormalizedUser(receipt.userJid));
+      const meta: any = await this.getGroupMetadataCache(key.remoteJid).catch(() => null);
+      const others = Array.isArray(meta?.participants) ? meta.participants.length - 1 : 0;
+      if (others > 0 && seen.readers.size >= others) {
+        seen.read = true;
+        send('READ');
+      }
+    }
+  }
+
   // zerosoft: claves de app-state que Baileys buscó y no estaban guardadas (por id, en base64). Las claves viven en
   // disco: una línea vinculada antes de tener volumen las perdió en un deploy, y el teléfono solo las manda al
   // vincular o si se las piden.
