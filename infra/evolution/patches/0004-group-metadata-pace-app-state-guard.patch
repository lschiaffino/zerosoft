+  private async assertAppStateReady() {
+    // Mismo formato que las excepciones de Evolution (el middleware responde { status, error, response: { message } }).
+    const unavailable = (reason: string) => ({ status: 409, error: 'Conflict', message: [`app_state_unavailable: ${reason}`] });
+    if (this.stateConnection?.state !== 'open') throw unavailable('not_connected');
+    const keyId = this.client?.authState?.creds?.myAppStateKeyId;
+    if (!keyId) throw unavailable('missing_key');
+    const keys = await this.client.authState.keys.get('app-state-sync-key', [keyId]);
+    if (!keys?.[keyId]) throw unavailable('missing_key');
+    await (this.client as any).resyncAppState(['regular_low'], false);
+    const versions = await this.client.authState.keys.get('app-state-sync-version', ['regular_low']);
+    if (!versions?.regular_low?.version) throw unavailable('sync_failed');
+  }
