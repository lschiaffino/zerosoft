--- a/Dockerfile
+++ b/Dockerfile
@@ -25,6 +25,43 @@ RUN f=node_modules/baileys/lib/Utils/chat-utils.js && \
     sed -i 's/: () => { }, true);/: () => { }, validateMacs);/' "$f" && \
     grep -q ': () => { }, validateMacs);' "$f"
 
+# zerosoft: cuando una colección de app-state no se puede leer, Baileys lo anota en nivel info (que no se guarda) y
+# borra su estado: la línea deja de archivar sin dejar rastro del motivo. Acá sale como error, con el motivo.
+RUN f=node_modules/baileys/lib/Socket/chats.js && \
+    grep -q 'logger.info({ name, error: error.stack }' "$f" && \
+    sed -i 's/logger.info({ name, error: error.stack }/logger.error({ name, error: error.stack }/' "$f" && \
+    grep -q 'logger.error({ name, error: error.stack }' "$f"
+
+# zerosoft: un REMOVE de app-state sobre una entrada que el estado local no tiene hacía fallar la colección entera
+# ("tried remove, but no previous op"): dos intentos y Baileys la abandonaba, así que la línea no leía ni mandaba
+# archivado (pasa en líneas recién vinculadas). WhatsApp Web y Baileys 7.0.0-rc14 saltean ese cambio y siguen.
+RUN f=node_modules/baileys/lib/Utils/chat-utils.js && \
+    grep -q "throw new Boom('tried remove, but no previous op', { data: { indexMac, valueMac } });" "$f" && \
+    sed -i "s/throw new Boom('tried remove, but no previous op', { data: { indexMac, valueMac } });/return;/" "$f" && \
+    ! grep -q 'tried remove, but no previous op' "$f"
+
+# zerosoft: un registro de app-state que no se puede leer ("bad decrypt", o basura al decodificarlo) tiraba la
+# colección entera: en la línea del dueño, recién vinculada el 18/11, regular_low no se pudo leer nunca por registros
+# así de su snapshot, y la línea no archivaba en ninguna dirección. Ahora ese registro se saltea, pero su MAC igual
+# entra en el hash de la colección (el hash se arma con los MAC, no con el contenido), así el estado local sigue
+# igual al del teléfono. Además se cuenta, por id de clave, cuántos registros se leyeron y cuántos no
+# (globalThis.__zsAppStateStats, lo muestra /chat/appState).
+RUN f=node_modules/baileys/lib/Utils/chat-utils.js && \
+    grep -q '        const result = aesDecrypt(encContent, key.valueEncryptionKey);' "$f" && \
+    grep -q '        const syncAction = proto.SyncActionData.decode(result);' "$f" && \
+    sed -i 's/        const result = aesDecrypt(encContent, key.valueEncryptionKey);/        let result; try { result = aesDecrypt(encContent, key.valueEncryptionKey); } catch (zsErr) { zsCount(record, "bad"); ltGenerator.mix({ indexMac: record.index.blob, valueMac: ogValueMac, operation: operation }); continue; }/' "$f" && \
+    sed -i 's/        const syncAction = proto.SyncActionData.decode(result);/        let syncAction; try { syncAction = proto.SyncActionData.decode(result); JSON.parse(Buffer.from(syncAction.index).toString()); } catch (zsErr) { zsCount(record, "bad"); ltGenerator.mix({ indexMac: record.index.blob, valueMac: ogValueMac, operation: operation }); continue; } zsCount(record, "ok");/' "$f" && \
+    echo 'function zsCount(record, k) { try { const id = Buffer.from(record.keyId.id).toString("base64"); const s = (globalThis.__zsAppStateStats = globalThis.__zsAppStateStats || {}); const e = (s[id] = s[id] || { ok: 0, bad: 0 }); e[k]++; } catch { } }' >> "$f" && \
+    grep -c 'zsCount(record, "bad")' "$f" | grep -q 2
+
+# zerosoft: qué respondió WhatsApp al pedir cada colección de app-state (atributos y nombres de los nodos, sin
+# contenido): si responde un error o nada, Baileys no lo anota y la colección queda sin leer sin motivo a la vista.
+# Queda en globalThis.__zsAppStateLast y lo muestra /chat/appState.
+RUN f=node_modules/baileys/lib/Socket/chats.js && \
+    grep -q '                const decoded = await extractSyncdPatches(result, config?.options);' "$f" && \
+    sed -i 's/                const decoded = await extractSyncdPatches(result, config?.options);/                try { for (const c of getBinaryNodeChildren(getBinaryNodeChild(result, "sync"), "collection")) { (globalThis.__zsAppStateLast = globalThis.__zsAppStateLast || {})[(authState.creds.me?.id || "").split(":")[0].slice(-4) + ":" + c.attrs.name] = { attrs: c.attrs, children: (Array.isArray(c.content) ? c.content : []).map(n => ({ tag: n.tag, attrs: n.attrs, size: n.content?.length })), at: new Date().toISOString() }; } } catch { }\n                const decoded = await extractSyncdPatches(result, config?.options);/' "$f" && \
+    grep -q '__zsAppStateLast' "$f"
+
 COPY ./src ./src
 COPY ./public ./public
 COPY ./prisma ./prisma
