{
  "git": {
    "deploymentEnabled": {
      "*": false,
      "main": true
    }
  },
  "crons": [
    {
      "path": "/api/cron/tick",
      "schedule": "17 * * * *"
    },
    {
      "path": "/api/cron/minute",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/cron/send-render",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/cron/calls",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/cron/robots",
      "schedule": "*/5 * * * *"
    }
  ],
  "functions": {
    "app/api/groups/live/route.ts": {
      "supportsCancellation": true
    },
    "app/api/inbox/live/route.ts": {
      "supportsCancellation": true
    }
  }
}
