# --- Auth (Google OAuth) ---
# Crear credenciales en https://console.cloud.google.com/apis/credentials
# Authorized redirect URIs:
#   http://localhost:3000/api/auth/callback/google                 (login)
#   http://localhost:3000/api/integrations/gmail/callback          (CRM ← Gmail)
#   http://localhost:3000/api/integrations/google-calendar/callback (Cal ↔ Google Calendar)
# Habilitar en Google Cloud: Gmail API y Google Calendar API.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- next-auth ---
# Generar con: openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# --- Demo ---
# true = entra al dashboard sin login, con el usuario demo (datos de scripts/seed.ts)
# Nunca usar en producción.
DEMO_MODE=true

# --- Links cortos ---
# Dominio público usado para mostrar los short links (sin barra final)
SHORT_DOMAIN=localhost:3000

# --- Base de datos (opcional) ---
# Sin setear → SQLite local en data/zerosoftware.db. Producción: Turso.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# --- Email (Resend) ---
# Sin key → los emails se loguean en consola (solo desarrollo).
RESEND_API_KEY=
EMAIL_FROM=calendar@zerosoft.ai

# --- Archivos (Vercel Blob) ---
# Obligatorio en Vercel: sin token los uploads devuelven 503.
# Fuera de Vercel, sin token se guardan en disco en UPLOADS_DIR (por defecto
# data/uploads, fuera de public/). Lo que haya en public/uploads se migra solo.
BLOB_READ_WRITE_TOKEN=
# UPLOADS_DIR=

# --- Cron ---
# Obligatorio en producción (Vercel Cron lo envía como Bearer).
CRON_SECRET=

# --- Rate limit ---
# true = desactiva los límites por IP (solo para tests de carga locales).
RATE_LIMIT_DISABLED=
# IP del cliente fuera de Vercel: se toma la entrada de X-Forwarded-For que
# agregó tu proxy (la de la derecha). Con varios proxies encadenados
# (CDN + nginx), TRUST_PROXY_HOPS = cuántos hay (por defecto 1).
# Sin proxy delante (la app expuesta directo) poné TRUST_PROXY=0: si no, un
# cliente puede mandar su propio X-Forwarded-For y elegir su cupo. Con 0 no se
# confía en ningún header y todos comparten un cupo. En Vercel no hace falta: se usa X-Vercel-Forwarded-For.
TRUST_PROXY_HOPS=
TRUST_PROXY=

# --- Cifrado ---
# Clave para cifrar tokens OAuth en la base (openssl rand -base64 32).
# Sin setear se deriva de NEXTAUTH_SECRET.
ENCRYPTION_KEY=
# Clave propia para las credenciales de Flow/Robots (/app/flow/credentials),
# cifradas con AES-256-GCM. Opcional: sin setear se deriva de ENCRYPTION_KEY o
# NEXTAUTH_SECRET. Cambiarla invalida las credenciales guardadas (hay que
# volver a cargarlas).
CREDENTIALS_KEY=

# --- Flow: nodo Código ---
# sandbox | none. El nodo Código corre JavaScript en Vercel Sandbox (microVM
# aislada, 30 s y 128 MB como máximo, sin red). Default: sandbox en Vercel o
# con VERCEL_TOKEN + VERCEL_TEAM_ID + VERCEL_PROJECT_ID; none en el resto (el
# nodo queda deshabilitado con un aviso).
FLOW_CODE_RUNNER=

# --- Enterprise (/ee) ---
# Key de licencia Enterprise (opcional). Sin ella, /ee queda apagado.
ZEROSOFT_LICENSE_KEY=
ZEROSOFT_LICENSE_PUBLIC_KEY=

# --- Webhooks ---
# true = permite webhooks a hosts privados/http (self-host en red interna). Nunca en la nube pública.
ALLOW_PRIVATE_WEBHOOKS=

# --- Link: dominios propios ---
# En Vercel: los dominios se agregan al proyecto por API (y obtienen HTTPS).
# Self-host: dejar vacío; los dominios se verifican por DNS.
VERCEL_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=
# Hosts extra que sirven la app (coma), para no tratarlos como dominios de links.
APP_HOSTS=

# --- Feedback ---
# Email que recibe un aviso por cada feedback nuevo (vacío = solo se guarda en la base).
FEEDBACK_EMAIL=
# Emails (coma) que ven el listado en /app/settings/feedback y /app/settings/roadmap.
# Vacío = las páginas dan 404. El primero que exista paga la clasificación AI del roadmap.
ADMIN_EMAILS=

# --- Soporte (Chat propio) ---
# Id de un widget de Chat del workspace del equipo (con bot 'ai'). Si está, el
# widget aparece en el sitio y en la app (con el email/nombre de la persona
# logueada), y cada conversación resuelta se clasifica para el roadmap.
SUPPORT_WIDGET_ID=

# --- AI (Vercel AI SDK vía Vercel AI Gateway) ---
# Key del AI Gateway (https://vercel.com/ai-gateway). En deploys de Vercel con
# AI Gateway habilitado alcanza con OIDC (sin key). Sin key ni Vercel, la AI
# queda apagada y el bot del chat usa keywords. Self-host: poné tu propia key.
AI_GATEWAY_API_KEY=
# Modelo "proveedor/modelo" del Gateway. Default: anthropic/claude-sonnet-5-5
AI_MODEL=
# Tokens gratis por workspace y mes (default 200000). "unlimited" = sin cuota
# (recomendado en self-host con tu propia key). Pasada la cuota, la AI se pausa
# hasta el mes siguiente (en la nube se medirá para facturar tokens × 1.2).
AI_FREE_TOKENS_PER_MONTH=
# Llamadas a AI por workspace y minuto (default 30).
AI_RATE_LIMIT_PER_MINUTE=
# false = apaga la AI aunque haya key u OIDC.
AI_ENABLED=

# --- Herramientas gratis (/tools) ---
# Opcional: key de Google PageSpeed Insights API. Si está, el Website grader
# suma el puntaje de performance mobile de Lighthouse. Sin key se omite.
PAGESPEED_API_KEY=
# URL pública del sitio (canonical absolutas, sitemap, JSON-LD).
NEXT_PUBLIC_SITE_URL=

# --- Robots (automatizaciones de navegador) ---
# Dónde corren los robots: sandbox | local | none.
#  - sandbox: Vercel Sandbox (microVM aislada). Default en Vercel (VERCEL=1):
#    usa OIDC solo. Fuera de Vercel necesita VERCEL_TOKEN + VERCEL_TEAM_ID +
#    VERCEL_PROJECT_ID (arriba) o VERCEL_OIDC_TOKEN de `vercel env pull`.
#  - local: playwright-core en este servidor (self-host). Default fuera de
#    Vercel cuando playwright-core está instalado (npm ci lo instala).
#    Instalá Chromium con `npx playwright-core install --with-deps chromium`
#    o apuntá ROBOTS_CHROMIUM_PATH a un Chrome/Chromium ya instalado.
#  - none: se pueden armar robots pero no correrlos.
ROBOTS_RUNNER=
# Ruta a Chromium para el runner local (opcional).
ROBOTS_CHROMIUM_PATH=
# Snapshot del sandbox con Chromium ya instalado (opcional; si falta, se arma
# solo en la primera corrida, ~1-2 min, y se guarda en la base). Crealo con:
#   npx tsx scripts/robots-sandbox-snapshot.ts
ROBOTS_SANDBOX_SNAPSHOT_ID=
# Minutos de robot gratis por workspace y mes (default 120). "unlimited" = sin cuota.
ROBOTS_FREE_MINUTES_PER_MONTH=
# Corridas por workspace y hora (default 30).
ROBOTS_RUNS_PER_HOUR=
# Proxy de salida de los robots (residencial). {country} = país elegido en el robot, {session} = id
# nuevo por corrida (IP nueva). Ej.: http://customer-acme-cc-{country}-sessid-{session}:SECRET@pr.oxylabs.io:7777
ROBOTS_PROXY_URL=
# Países ofrecidos con proxy (us,ar,br…); vacío = todos. País por defecto si el robot no elige uno (us).
ROBOTS_PROXY_COUNTRIES=
ROBOTS_PROXY_DEFAULT_COUNTRY=
# Emails de cambios por robot y día (default 24) y lecturas de página del constructor con IA por hora (default 30).
ROBOTS_CHANGE_EMAILS_PER_DAY=
ROBOTS_SNAPSHOTS_PER_HOUR=
